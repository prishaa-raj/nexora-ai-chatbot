# Copy this file to .env and fill in real values before running.
# Never commit the real .env file.

# --- MongoDB ---
MONGO_URI=mongodb://localhost:27017
MONGO_DB_NAME=chatbot_db

# --- JWT ---
# Generate a real secret, e.g.: python -c "import secrets; print(secrets.token_hex(32))"
# The app REFUSES to start in production (ENVIRONMENT=production) if this is
# left at the placeholder value.
JWT_SECRET=2oirhwehflflnsdjlfnshfowhf
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# --- LLM providers (set at least one; Gemini is tried first) ---
GEMINI_API_KEY=GEMINI_API_KEY
GEMINI_MODEL=gemini-2.0-flash
OPENAI_API_KEY=your-openai-key-here
OPENAI_MODEL=gpt-4o-mini
GROQ_API_KEY=GROQ_API_KEY
GROQ_MODEL=llama-3.3-70b-versatile
# --- Embeddings ---
EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2

# --- ChromaDB ---
CHROMA_PERSIST_DIR=./chroma_data
CHROMA_COLLECTION_NAME=knowledge_base

# --- App ---
# Comma-separated list of allowed frontend origins. In production this must
# be your real deployed frontend URL(s) -- never "*".
CORS_ORIGINS=http://localhost:5173
SEED_DEMO_DATA=true
# "development" or "production" -- controls the JWT-secret startup guard,
# HSTS header, and other prod-only behavior.
ENVIRONMENT=development

# --- Security / deployment ---
MAX_UPLOAD_MB=10
# slowapi rate-limit string applied to /api/auth/login and /api/auth/register
RATE_LIMIT_AUTH=10/minute
